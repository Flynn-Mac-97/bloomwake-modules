    white-space: normal;
}

.dsection__hint {
    color: rgb(154, 138, 104);
    font-size: 12px;
    margin-top: 6px;
    white-space: normal;
}

.dstep {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.dstep__dot {
    width: 12px;
    height: 12px;
    rotate: 45deg;
    border-radius: 2px;
    background-color: rgb(94, 138, 60);
    margin-right: 11px;
}

.dstep__dot--off {
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgb(178, 158, 112);
}

.dstep__text {
    color: rgb(74, 62, 40);
    font-size: 17px;
}

.dstep__text--off {
    color: rgb(154, 138, 104);
}

.dstep__state {
    margin-left: auto;
    font-size: 11px;
    letter-spacing: 0.3px;
    color: rgb(94, 122, 46);
}

.dstep__state--off {
    color: rgb(167, 152, 104);
}

.line-flow {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: 0 6px 10px 0;
}

.lw {
    color: rgb(74, 62, 40);
    font-size: 21px;
    margin: 0 5px 3px 0;
    padding: 0;
}

.term {
    color: rgb(176, 121, 30);
    font-size: 21px;
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: rgb(199, 154, 60);
    padding: 0 3px 1px 3px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.term:hover {
    background-color: rgba(199, 154, 60, 0.16);
    border-bottom-color: rgb(176, 121, 30);
}

.term__diamond {
    width: 8px;
    height: 8px;
    rotate: 45deg;
    border-radius: 2px;
    background-color: rgb(199, 154, 60);
    margin: 0 5px 3px 0;
}

.termcard {
    position: absolute;
    right: 430px;
    bottom: 300px;
    width: 262px;
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.termcard--in {
    opacity: 1;
    translate: 0 0;
}

.termcard__panel {
    background-color: rgba(236, 224, 194, 0);
    border-width: 2px;
    border-top-color: rgb(185, 164, 114);
    border-left-color: rgb(174, 151, 101);
    border-right-color: rgb(138, 113, 71);
    border-bottom-color: rgb(130, 104, 60);
    border-radius: 14px;
    padding: 20px 18px 16px 18px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-image: url("project://database/Assets/Flynn/Modules/CozyDialogue/UI/UI%20Kit1/UI%20(7).png?fileID=21300000&guid=818b8da7cda7fce4bb44fc4439473d69&type=3#UI (7)");
    -unity-slice-scale: 2px;
}

.termcard__tab {
    position: absolute;
    top: -13px;
    left: 16px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(166, 192, 136);
    border-width: 2px;
    border-color: rgb(236, 224, 194);
    border-radius: 9px;
    padding: 3px 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.termcard__tab-text {
    color: rgb(46, 61, 34);
    font-size: 15px;
}

.termcard__tab-dot {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: rgb(60, 74, 40);
    margin-left: 7px;
    justify-content: center;
    align-items: center;
}

.termcard__tab-diamond {
    width: 6px;
    height: 6px;
    rotate: 45deg;
    border-radius: 1px;
    background-color: rgb(228, 217, 188);
}

.termcard__x {
    position: absolute;
    top: -11px;
    right: 12px;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: rgb(236, 224, 194);
    border-width: 2px;
    border-color: rgb(156, 133, 82);
    color: rgb(74, 62, 40);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.termcard__x:hover {
    background-color: rgb(247, 237, 212);
}

.termcard__label {
    color: rgb(138, 122, 82);
    font-size: 10px;
    letter-spacing: 1.5px;
}

.termcard__body {
    color: rgb(74, 62, 40);
    font-size: 15px;
    margin-top: 0;
    white-space: normal;
}

.termcard__body--corrupt {
    color: rgb(176, 121, 30);
    font-size: 10px;
    letter-spacing: 0.3px;
}

.termcard__note {
    background-color: rgb(42, 55, 32);
    border-radius: 9px;
    padding: 11px 13px;
    margin-top: 13px;
}

.termcard__note-label {
    color: rgb(143, 191, 90);
    font-size: 10px;
    letter-spacing: 1.2px;
    margin-bottom: 5px;
}

.termcard__note-text {
    color: rgb(231, 220, 190);
    font-size: 13px;
    white-space: normal;
}

.hovercue {
    -unity-font-definition: url("project://database/Assets/Flynn/Art/Placeholder_UI/Fonts/Alegreya-VF.ttf?fileID=12800000&guid=d6e02116ce71a83479764a5cdb2c20a2&type=3#Alegreya-VF");
    position: absolute;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    justify-content: center;
    align-items: center;
    background-color: rgba(42, 55, 32, 0.88);
    border-width: 2px;
    border-color: rgb(143, 191, 90);
    transform-origin: 50% 50%;
    opacity: 0;
    scale: 0.4 0.4;
    transition-property: opacity, scale, border-color;
    transition-duration: 0.1s, 0.22s, 0.15s;
    transition-timing-function: ease-out, ease-out-back, ease;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.hovercue--in {
    opacity: 1;
    scale: 1 1;
}

.hovercue--inspect {
    border-color: rgb(199, 154, 60);
}

.hovercue--decode {
    border-color: rgb(217, 179, 106);
}

.hovercue__icon {
    width: 16px;
    height: 16px;
    display: none;
}

.hovercue__chat {
    width: 14px;
    height: 10px;
    border-radius: 4px;
    background-color: rgb(231, 220, 190);
    display: none;
}

.hovercue--chat .hovercue__chat {
    display: flex;
}

.hovercue__chat-tail {
    position: absolute;
    bottom: -2px;
    left: 3px;
    width: 5px;
    height: 5px;
    background-color: rgb(231, 220, 190);
    rotate: 45deg;
}

.hovercue__badge {
    position: absolute;
    right: -4px;
    bottom: -4px;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(236, 224, 194);
    border-width: 1px;
    border-color: rgb(156, 133, 82);
    justify-content: center;
    align-items: center;
    display: none;
}

.hovercue--known .hovercue__badge {
    display: flex;
}

.hovercue__badge-diamond {
    width: 6px;
    height: 6px;
    rotate: 45deg;
    border-radius: 1px;
    background-color: rgb(94, 138, 60);
}

.decode-scrim {
    -unity-font-definition: url("project://database/Assets/Flynn/Art/Placeholder_UI/Fonts/Alegreya-VF.ttf?fileID=12800000&guid=d6e02116ce71a83479764a5cdb2c20a2&type=3#Alegreya-VF");
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(14, 20, 8, 0.6);
    justify-content: center;
    align-items: center;
}

.decode {
    width: 560px;
    background-color: rgb(236, 224, 194);
    border-width: 2px;
    border-top-color: rgb(185, 164, 114);
    border-left-color: rgb(174, 151, 101);
    border-right-color: rgb(138, 113, 71);
    border-bottom-color: rgb(130, 104, 60);
    border-radius: 18px;
    padding: 24px 26px;
    opacity: 0;
    translate: 0 16px;
    scale: 0.985 0.985;
    transition-property: opacity, translate, scale;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
}

.decode--in {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.decode__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.decode__head-diamond {
    width: 10px;
    height: 10px;
    rotate: 45deg;
    border-radius: 2px;
    background-color: rgb(94, 138, 60);
    margin-right: 9px;
}

.decode__title {
    color: rgb(94, 122, 46);
    font-size: 12px;
    letter-spacing: 2px;
    flex-grow: 1;
}

.decode__light {
    width: 10px;
    height: 10px;
    rotate: 45deg;
    border-radius: 2px;
    background-color: rgb(199, 154, 60);
}

.decode__light--ok {
    background-color: rgb(143, 191, 90);
}

.decode__meter {
    flex-direction: row;
    margin-top: 14px;
}

.decode__seg {
    width: 14px;
    height: 7px;
    border-radius: 3px;
    background-color: rgb(220, 203, 158);
    margin-right: 4px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.decode__seg--on {
    background-color: rgb(199, 154, 60);
}

.decode__seg--ok {
    background-color: rgb(143, 191, 90);
}

.decode__readout {
    background-color: rgb(42, 55, 32);
    border-radius: 12px;
    height: 110px;
    margin-top: 14px;
    padding: 14px 16px;
    overflow: hidden;
}

.decode__sweep {
    position: absolute;
    left: 0;
    right: 0;
    height: 24px;
    background-color: rgba(143, 191, 90, 0.14);
}

.decode__body {
    color: rgb(231, 220, 190);
    font-size: 14px;
    white-space: normal;
}

.decode__body--corrupt {
    color: rgb(217, 179, 106);
    font-size: 10px;
    letter-spacing: 0.3px;
}

.dstage {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.dstage__dot {
    width: 12px;
    height: 12px;
    rotate: 45deg;
    border-radius: 2px;
    background-color: rgb(216, 201, 160);
    margin-right: 10px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.dstage__dot--active {
    background-color: rgb(199, 154, 60);
}

.dstage__dot--done {
    background-color: rgb(94, 138, 60);
}

.dstage__text {
    color: rgb(74, 62, 40);
    font-size: 14px;
    flex-grow: 1;
}

.dstage__state {
    color: rgb(138, 122, 82);
    font-size: 10px;
    letter-spacing: 1px;
}

.dstage__state--done {
    color: rgb(94, 122, 46);
}

.decode__buttons {
    flex-direction: row;
    justify-content: flex-start;
    margin-top: 18px;
}

.decode__btn {
    background-color: rgb(94, 138, 60);
    border-width: 2px;
    border-color: rgb(74, 110, 46);
    color: rgb(241, 234, 214);
    border-radius: 11px;
    padding: 10px 20px;
    margin-right: 9px;
    font-size: 15px;
    -unity-font-style: bold;
    transition-property: background-color, translate;
    transition-duration: 0.15s;
}

.decode__btn:hover {
    background-color: rgb(110, 154, 70);
    translate: 0 -1px;
}

.decode__btn--quiet {
    background-color: rgb(239, 228, 198);
    border-color: rgb(201, 181, 131);
    color: rgb(106, 90, 56);
    font-size: 14px;
    -unity-font-style: normal;
}

.decode__btn--quiet:hover {
    background-color: rgb(247, 237, 212);
}

.badge__leave-icon {
    background-image: url("project://database/Assets/Flynn/Textures/solarpunk_icons.png?fileID=-484169569&guid=f7e6b187e70a3e14bb18c7a75891a324&type=3#solarpunk_icons_0");
    -unity-background-image-tint-color: rgb(74, 62, 40);
    -unity-background-scale-mode: scale-to-fit;
}

.trust-chip__icon {
    width: 32px;
    height: -507px;
    background-image: url("project://database/Assets/Flynn/Textures/solarpunk_icons.png?fileID=1877797184&guid=f7e6b187e70a3e14bb18c7a75891a324&type=3#solarpunk_icons_15");
    -unity-background-image-tint-color: rgb(240, 231, 204);
}

.say-send__icon {
    background-image: url("project://database/Assets/Flynn/Textures/solarpunk_icons.png?fileID=2140880179&guid=f7e6b187e70a3e14bb18c7a75891a324&type=3#solarpunk_icons_1");
    -unity-background-image-tint-color: rgb(240, 231, 204);
    -unity-background-scale-mode: scale-to-fit;
}

.hovercue--inspect .hovercue__icon {
    display: flex;
    background-image: url("project://database/Assets/Flynn/Textures/solarpunk_icons.png?fileID=114461880&guid=f7e6b187e70a3e14bb18c7a75891a324&type=3#solarpunk_icons_20");
    -unity-background-image-tint-color: rgb(231, 220, 190);
    -unity-background-scale-mode: scale-to-fit;
}

.hovercue--decode .hovercue__icon {
    display: flex;
    background-image: url("project://database/Assets/Flynn/Textures/solarpunk_icons.png?fileID=177158389&guid=f7e6b187e70a3e14bb18c7a75891a324&type=3#solarpunk_icons_31");
    -unity-background-image-tint-color: rgb(231, 220, 190);
    -unity-background-scale-mode: scale-to-fit;
}

