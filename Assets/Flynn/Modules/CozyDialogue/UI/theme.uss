.bevel {
    position: absolute;
    left: 5px;
    right: 5px;
    top: 5px;
    bottom: 5px;
    border-width: 1px;
    border-color: rgb(219, 206, 164);
    border-radius: 14px;
}

.bevel--tight {
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 6px;
    border-color: rgb(201, 181, 131);
    border-radius: 11px;
}

.top-bar {
    -unity-font-definition: url("project://database/Assets/Flynn/Art/Placeholder_UI/Fonts/Alegreya-VF.ttf?fileID=12800000&guid=d6e02116ce71a83479764a5cdb2c20a2&type=3#Alegreya-VF");
    position: absolute;
    top: 18px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(42, 55, 32, 0.86);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 11px;
    padding: 8px 15px;
    margin: 0 6px;
    border-bottom-color: rgba(17, 17, 17, 0.23);
    border-left-color: rgba(17, 17, 17, 0.23);
    border-right-color: rgba(17, 17, 17, 0.23);
    border-top-color: rgba(17, 17, 17, 0.23);
    border-bottom-width: 2px;
}

.chip__text {
    color: rgb(231, 220, 190);
    font-size: 15px;
    -unity-font-style: bold;
}

.chip__count {
    color: rgb(143, 191, 90);
    font-size: 15px;
    -unity-font-style: bold;
    margin-left: 9px;
}

.leaf-dot {
    width: 14px;
    height: 14px;
    background-image: url("project://database/Assets/Flynn/Textures/solarpunk_icons.png?fileID=-1907679772&guid=f7e6b187e70a3e14bb18c7a75891a324&type=3#solarpunk_icons_32");
    -unity-background-image-tint-color: rgb(143, 191, 90);
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 8px;
}

.gauge {
    width: 46px;
    height: 46px;
    margin: 0 5px;
}

.gauge__disc {
    position: absolute;
    left: 5px;
    right: 5px;
    top: 5px;
    bottom: 5px;
    border-radius: 18px;
    background-color: rgba(240, 231, 204, 0.84);
    border-width: 2px;
    border-color: rgb(201, 181, 131);
    justify-content: center;
    align-items: center;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 3px;
    border-left-width: 1px;
    border-left-color: rgba(201, 181, 131, 0.78);
    border-right-color: rgba(201, 181, 131, 0.78);
    border-top-color: rgba(201, 181, 131, 0.78);
    border-bottom-color: rgba(201, 181, 131, 0.78);
}

.gauge__num {
    color: rgb(38, 51, 29);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dialogue-root {
    -unity-font-definition: url("project://database/Assets/Flynn/Art/Placeholder_UI/Fonts/Alegreya-VF.ttf?fileID=12800000&guid=d6e02116ce71a83479764a5cdb2c20a2&type=3#Alegreya-VF");
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: 0;
}

.dialogue-box {
    position: absolute;
    bottom: 40px;
    left: 50%;
    margin-left: 0;
    translate: -50% 340px;
    width: 600px;
    background-color: rgb(255, 255, 222);
    border-width: 2px;
    border-top-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-radius: 16px;
    padding: 24px 32px 26px 32px;
    transition-property: translate, scale;
    transition-duration: 0.45s, 0.12s;
    transition-timing-function: ease-out-back, ease;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-right-radius: 17px;
    border-bottom-left-radius: 17px;
    background-image: none;
    padding-bottom: 0;
}

.dialogue-box--open {
    translate: -50% 0;
}

.dialogue-box--closing {
    transition-duration: 0.18s, 0.12s;
    transition-timing-function: ease-in, ease;
}

.dialogue-box--dip {
    scale: 0.985 0.985;
}

.dialogue-tail {
    position: absolute;
    right: -11px;
    top: 70px;
    width: 20px;
    height: 20px;
    rotate: 45deg;
    background-color: rgb(236, 224, 194);
    border-width: 2px;
    border-color: rgb(138, 113, 71);
    border-left-color: rgba(138, 113, 71, 0);
    border-bottom-color: rgba(138, 113, 71, 0);
}

.badge {
    position: absolute;
    flex-direction: row;
    align-items: flex-end;
    translate: 0 -100%;
    -unity-slice-scale: 0.5px;
    border-left-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.badge--name {
    top: 14px;
    right: 22px;
    background-color: rgb(166, 192, 136);
    border-width: 2px;
    border-top-color: rgb(140, 156, 96);
    border-left-color: rgb(140, 156, 96);
    border-right-color: rgb(106, 122, 66);
    border-bottom-color: rgb(106, 122, 66);
    border-radius: 10px;
    padding: 8px 20px 9px 20px;
}

.trust-chip {
    flex-direction: row;
    align-items: center;
    margin-left: 0;
    padding: 2px 8px 3px 6px;
    background-color: rgb(133, 159, 113);
    border-radius: 10px;
    transition-property: scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
    background-image: none;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}

.trust-chip--pulse {
    scale: 1.25 1.25;
}

.trust-chip__count {
    color: rgb(240, 231, 204);
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 4px;
}

.badge__name {
    font-size: 24px;
    -unity-text-align: upper-center;
    -unity-font-style: bold;
}

.badge__role {
}

.badge--leave {
    top: 14px;
    left: 22px;
    background-color: rgb(240, 231, 204);
    border-width: 2px;
    border-top-color: rgb(218, 203, 160);
    border-left-color: rgb(218, 203, 160);
    border-right-color: rgb(183, 160, 107);
    border-bottom-color: rgb(183, 160, 107);
    border-radius: 10px;
    padding: 8px 17px 9px 17px;
    align-items: center;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.badge--leave:hover {
    background-color: rgb(250, 242, 220);
}

.badge__leave-icon {
    width: 26px;
    height: 26px;
    margin-right: 7px;
}

.badge__leave-text {
    color: rgb(74, 62, 40);
    font-size: 15px;
    -unity-font-style: bold;
}

.dialogue-scroll {
    height: 137px;
    margin: 2px 0 0 0;
    background-color: rgb(255, 253, 217);
    border-width: 1px;
    border-top-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-radius: 10px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.unity-scroller--vertical {
    width: 10px;
    min-width: 10px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroller--vertical .unity-scroller__low-button {
    display: none;
}

.unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.unity-scroller--vertical .unity-scroller__slider {
    margin-top: 0;
    margin-bottom: 0;
    width: 10px;
    min-width: 10px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(156, 133, 82, 0.14);
    border-width: 0;
    border-radius: 3px;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    width: 8px;
    left: 1px;
    background-color: rgb(201, 181, 131);
    border-width: 0;
    border-radius: 3px;
}

.unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgb(156, 133, 82);
}

.dialogue-scroll .unity-scroll-view__content-container {
    padding-top: 8px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 10px;
}

.para {
    transition-property: opacity;
    transition-duration: 0.25s;
}

.para--old {
    opacity: 0.5;
}

.dialogue-line {
    color: rgb(74, 62, 40);
    font-size: 21px;
    white-space: normal;
    margin: 0 6px 10px 0;
    margin-bottom: 0;
    margin-right: 0;
}

.choices {
    flex-direction: column;
    margin-top: 0;
    min-height: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition-property: max-height, min-height, opacity, margin-top;
    transition-duration: 0.5s, 0.5s, 0.35s, 0.5s;
    transition-timing-function: ease-out;
}

.choices--open {
    margin-top: 6px;
    min-height: 36px;
    max-height: 150px;
    opacity: 1;
}

.choice {
    flex-direction: row;
    align-items: center;
    width: 100%;
    background-color: rgba(244, 236, 211, 0);
    border-width: 2px;
    border-top-color: rgb(218, 203, 160);
    border-left-color: rgb(218, 203, 160);
    border-right-color: rgb(183, 160, 107);
    border-bottom-color: rgb(183, 160, 107);
    border-radius: 13px;
    min-height: 33px;
    flex-shrink: 0;
    padding: 3px 12px 4px 12px;
    margin: 0 0 4px 0;
    color: rgb(36, 36, 36);
    font-size: 21px;
    -unity-font-style: normal;
    opacity: 0;
    translate: 0 6px;
    transition-property: opacity, translate, background-color;
    transition-duration: 0.32s, 0.18s, 0.16s;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    background-image: none;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 10px;
    margin-bottom: 5px;
    -unity-slice-scale: 1.1px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.48);
    -unity-text-align: upper-left;
    bottom: 1px;
}

.choice > Label {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.choice--in {
    opacity: 1;
    translate: 0 0;
}

.choice:hover {
    background-color: rgb(250, 242, 220);
    translate: 0 -1px;
}

.choice__bullet {
    width: 10px;
    height: 10px;
    rotate: 45deg;
    border-radius: 2px;
    background-color: rgb(94, 138, 60);
    margin-right: 9px;
}

.choice__bullet--hot {
    background-color: rgb(199, 154, 60);
}

.choice--locked {
    background-color: rgba(94, 85, 60, 0.11);
}

.choice--locked:hover {
    background-color: rgb(232, 221, 192);
    translate: 0 0;
}

.choice__lock {
    width: 26px;
    height: 26px;
    margin-right: 0;
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Assets/Flynn/Textures/solarpunk_icons.png?fileID=-997411469&guid=f7e6b187e70a3e14bb18c7a75891a324&type=3#solarpunk_icons_22");
    -unity-background-image-tint-color: rgb(113, 77, 0);
    -unity-background-scale-mode: scale-to-fit;
    align-items: auto;
}

.choice__hint {
    background-color: rgb(110, 140, 57);
    color: rgb(255, 255, 255);
    border-radius: 6px;
    padding: 3px 7px;
    margin-left: auto;
    flex-shrink: 0;
    font-size: 13px;
    letter-spacing: 1px;
}

.say-row {
    flex-direction: row;
    align-items: center;
    margin-top: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition-property: max-height, opacity, margin-top;
    transition-duration: 0.45s, 0.35s, 0.45s;
    transition-timing-function: ease-out;
}

.say-row--open {
    margin-top: 8px;
    max-height: 54px;
    opacity: 1;
}

.say-input {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
    height: 51px;
    background-image: none;
}

.say-input .unity-base-text-field__input {
    background-color: rgb(244, 236, 214);
    border-width: 1px;
    border-color: rgb(201, 181, 131);
    border-radius: 8px;
    padding: 8px 16px;
    color: rgb(74, 62, 40);
    font-size: 16px;
}

.say-input .unity-base-text-field__input:focus {
    background-color: rgb(250, 244, 224);
    border-color: rgb(156, 133, 82);
}

.say-input--hint .unity-base-text-field__input {
    color: rgb(138, 122, 82);
}

.say-send {
    width: 46px;
    height: 44px;
    flex-shrink: 0;
    background-color: rgb(78, 125, 35);
    border-width: 2px;
    border-color: rgb(74, 110, 46);
    border-radius: 8px;
    margin: 0 0 0 8px;
    padding: 0;
    justify-content: center;
    align-items: center;
    transition-property: background-color;
    transition-duration: 0.15s;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-image: none;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.75);
    border-left-color: rgba(27, 38, 18, 0.68);
    border-right-color: rgba(27, 38, 18, 0.68);
    border-top-color: rgba(27, 38, 18, 0.68);
    border-bottom-color: rgba(27, 38, 18, 0.68);
}

.say-send:hover {
    background-color: rgb(110, 154, 70);
}

.say-send__icon {
    width: 24px;
    height: 22px;
}

.proceed {
    width: 14px;
    height: 14px;
    align-self: flex-end;
    margin-top: 4px;
    background-image: url("project://database/Assets/Flynn/Textures/solarpunk_icons.png?fileID=-2074525900&guid=f7e6b187e70a3e14bb18c7a75891a324&type=3#solarpunk_icons_3");
    -unity-background-image-tint-color: rgb(140, 118, 76);
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.2s, 0.4s;
    transition-timing-function: ease, ease-in-out;
}

.proceed--in {
    opacity: 1;
}

.proceed--alt {
    translate: 0 3px;
}

.portrait {
    position: absolute;
    right: 44px;
    bottom: 0;
    width: 380px;
    height: 420px;
    -unity-background-scale-mode: scale-to-fit;
    translate: 0 90px;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.8s;
    transition-timing-function: ease-out;
}

.portrait--in {
    translate: 0 0;
    opacity: 1;
}

.bark {
    -unity-font-definition: url("project://database/Assets/Flynn/Art/Placeholder_UI/Fonts/Alegreya-VF.ttf?fileID=12800000&guid=d6e02116ce71a83479764a5cdb2c20a2&type=3#Alegreya-VF");
    position: absolute;
    max-width: 300px;
    translate: 0 -100%;
    align-items: center;
    transform-origin: 50% 100%;
    opacity: 0;
    scale: 0.25 0.25;
    transition-property: opacity, scale;
    transition-duration: 0.12s, 0.32s;
    transition-timing-function: ease-out, ease-out-back;
}

.bark--in {
    opacity: 1;
    scale: 1 1;
}

.bark__bubble {
    background-color: rgb(236, 224, 194);
    border-width: 2px;
    border-top-color: rgb(185, 164, 114);
    border-left-color: rgb(174, 151, 101);
    border-right-color: rgb(138, 113, 71);
    border-bottom-color: rgb(130, 104, 60);
    border-radius: 12px;
    padding: 7px 12px 8px 12px;
}

.bark__line {
    color: rgb(74, 62, 40);
    font-size: 14px;
    white-space: normal;
}

.bark__tail {
    width: 13px;
    height: 13px;
    background-color: rgb(236, 224, 194);
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: rgb(130, 104, 60);
    rotate: 45deg;
    margin-top: -8px;
}

.bark__replies {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 6px;
}

.bark__reply {
    background-color: rgb(240, 231, 203);
    border-width: 2px;
    border-color: rgb(201, 181, 131);
    border-radius: 12px;
    padding: 4px 11px;
    margin: 3px 3px 0 3px;
    color: rgb(74, 62, 40);
    font-size: 13px;
    transition-property: background-color, border-color, translate;
    transition-duration: 0.15s;
}

.bark__reply:hover {
    background-color: rgb(247, 239, 214);
    border-color: rgb(94, 138, 60);
    translate: 0 -1px;
}

.bark__reply--chat {
    background-color: rgb(94, 138, 60);
    border-color: rgb(74, 110, 46);
    color: rgb(241, 234, 214);
    -unity-font-style: bold;
}

.bark__reply--chat:hover {
    background-color: rgb(110, 154, 70);
    border-color: rgb(74, 110, 46);
}

.alerts {
    position: absolute;
    top: 74px;
    right: 24px;
}

.alert {
    -unity-font-definition: url("project://database/Assets/Flynn/Art/Placeholder_UI/Fonts/Alegreya-VF.ttf?fileID=12800000&guid=d6e02116ce71a83479764a5cdb2c20a2&type=3#Alegreya-VF");
    width: 294px;
    background-color: rgb(236, 224, 194);
    border-width: 2px;
    border-top-color: rgb(185, 164, 114);
    border-left-color: rgb(174, 151, 101);
    border-right-color: rgb(138, 113, 71);
    border-bottom-color: rgb(130, 104, 60);
    border-radius: 13px;
    margin-bottom: 9px;
    padding: 12px 13px;
    flex-direction: row;
    opacity: 0;
    translate: 24px 0;
    transition-property: opacity, translate;
    transition-duration: 0.34s;
    transition-timing-function: ease-out;
}

.alert--in {
    opacity: 1;
    translate: 0 0;
}

.alert__tile {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    margin-right: 11px;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.alert__tile--green {
    background-color: rgb(143, 191, 90);
    color: rgb(30, 61, 20);
}

.alert__tile--amber {
    background-color: rgb(227, 163, 104);
    color: rgb(74, 46, 22);
}

.alert__tile--copper {
    background-color: rgb(217, 179, 106);
    color: rgb(74, 54, 24);
}

.alert__body {
    flex-grow: 1;
}

.alert__cat-row {
    flex-direction: row;
    align-items: center;
}

.alert__dot {
    width: 7px;
    height: 7px;
    rotate: 45deg;
    border-radius: 1px;
    background-color: rgb(199, 154, 60);
    margin-right: 7px;
    transition-property: opacity;
    transition-duration: 0.45s;
}

.alert__dot--dim {
    opacity: 0.3;
}

.alert__cat {
    color: rgb(138, 122, 82);
    font-size: 10px;
    letter-spacing: 1px;
}

.alert__name {
    color: rgb(60, 50, 32);
    font-size: 16px;
    margin-top: 3px;
}

.alert__view {
    color: rgb(94, 138, 60);
    font-size: 10px;
    letter-spacing: 1px;
    margin-top: 7px;
}

.alert__view:hover {
    color: rgb(110, 154, 70);
}

.alert__x {
    position: absolute;
    top: 2px;
    right: 4px;
    width: 22px;
    height: 22px;
    font-size: 16px;
    -unity-text-align: middle-center;
    color: rgb(183, 161, 113);
}

.alert__x:hover {
    color: rgb(122, 106, 66);
}

.archive-layer {
    -unity-font-definition: url("project://database/Assets/Flynn/Art/Placeholder_UI/Fonts/Alegreya-VF.ttf?fileID=12800000&guid=d6e02116ce71a83479764a5cdb2c20a2&type=3#Alegreya-VF");
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.archive-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    flex-direction: row;
    justify-content: center;
}

.archive-btn {
    flex-direction: row;
    align-items: center;
    background-color: rgb(42, 55, 32);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 11px;
    padding: 7px 15px 7px 9px;
    transition-property: background-color, translate;
    transition-duration: 0.16s;
}

.archive-btn:hover {
    background-color: rgb(51, 66, 31);
    translate: 0 -1px;
}

.archive-btn__key {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background-color: rgb(240, 231, 204);
    color: rgb(38, 51, 29);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.archive-btn__text {
    color: rgb(231, 220, 190);
    font-size: 15px;
    -unity-font-style: bold;
    margin-left: 10px;
}

.archive-btn__dot {
    width: 8px;
    height: 8px;
    rotate: 45deg;
    border-radius: 2px;
    background-color: rgb(199, 154, 60);
    margin-left: 9px;
}

.archive-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(20, 30, 12, 0.28);
}

.drawer {
    position: absolute;
    right: 18px;
    top: 16px;
    bottom: 48px;
    width: 440px;
    background-color: rgb(236, 224, 194);
    border-width: 2px;
    border-top-color: rgb(185, 164, 114);
    border-left-color: rgb(174, 151, 101);
    border-right-color: rgb(138, 113, 71);
    border-bottom-color: rgb(130, 104, 60);
    border-radius: 16px;
    padding: 26px 24px 24px 24px;
    opacity: 0;
    translate: 30px 0;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.drawer > .bevel {
    display: none;
}

.drawer--in {
    opacity: 1;
    translate: 0 0;
}

.drawer__head {
    flex-direction: row;
    align-items: flex-start;
    padding: 0 2px 14px 2px;
}

.drawer__grip {
    width: 48px;
    height: 48px;
    background-image: url("project://database/Assets/Flynn/Textures/solarpunk_icons.png?fileID=589861722&guid=f7e6b187e70a3e14bb18c7a75891a324&type=3#solarpunk_icons_16");
    -unity-background-image-tint-color: rgba(100, 86, 53, 0.87);
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 0;
}

.drawer__title {
    color: rgb(100, 86, 53);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.drawer__count {
    color: rgba(100, 86, 53, 0.7);
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 10px;
    flex-grow: 1;
    -unity-text-align: upper-left;
}

.drawer__x {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    background-image: url("project://database/Assets/Flynn/Textures/solarpunk_icons.png?fileID=-1546690204&guid=f7e6b187e70a3e14bb18c7a75891a324&type=3#solarpunk_icons_7");
    -unity-background-image-tint-color: rgba(70, 51, 3, 0.9);
    -unity-background-scale-mode: scale-to-fit;
    color: rgba(0, 0, 0, 0);
    font-size: 14px;
    -unity-text-align: middle-center;
    transition-property: background-color, -unity-background-image-tint-color;
    transition-duration: 0.15s;
}

.drawer__x:hover {
    background-color: rgb(250, 242, 220);
    -unity-background-image-tint-color: rgb(74, 62, 40);
}

.drawer__chips {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0 2px 8px 2px;
}

.fchip {
    background-color: rgb(242, 233, 206);
    border-width: 1px;
    border-color: rgb(201, 181, 131);
    border-radius: 999px;
    color: rgb(138, 122, 82);
    padding: 6px 14px 7px 14px;
    margin: 0 6px 6px 0;
    font-size: 15px;
    transition-property: background-color, color, translate;
    transition-duration: 0.15s;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-width: 3px;
    border-bottom-color: rgba(201, 181, 131, 0.84);
}

.fchip:hover {
    background-color: rgb(250, 242, 220);
    translate: 0 -1px;
}

.fchip--on {
    background-color: rgb(42, 55, 32);
    border-color: rgb(42, 55, 32);
    color: rgb(231, 220, 190);
    border-bottom-color: rgb(110, 118, 86);
    border-right-color: rgb(110, 118, 86);
    border-top-color: rgb(110, 118, 86);
    border-left-color: rgb(110, 118, 86);
}

.fchip__dot {
    width: 6px;
    height: 6px;
    rotate: 45deg;
    border-radius: 1px;
    background-color: rgb(199, 154, 60);
    margin-left: 5px;
    align-self: center;
}

.drawer__scroll {
    flex-grow: 1;
}

.drawer__section {
    color: rgb(100, 86, 53);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin: 8px 4px 10px 4px;
}

.drawer__divider {
    height: 1px;
    background-color: rgb(220, 203, 158);
    margin: 10px 2px 8px 2px;
}

.fentry {
    margin-bottom: 9px;
}

.fentry__expand {
    padding: 6px 2px 2px 2px;
    padding-top: 2px;
}

.fentry--open .frow {
    background-color: rgb(247, 231, 190);
    border-color: rgb(156, 133, 82);
}

.fentry > .frow {
    margin-bottom: 0;
}

.fentry--open .frow__chev {
    rotate: 90deg;
}

.frow {
    flex-direction: row;
    align-items: center;
    background-color: rgb(244, 236, 211);
    border-width: 2px;
    border-top-color: rgb(218, 203, 160);
    border-left-color: rgb(218, 203, 160);
    border-right-color: rgb(183, 160, 107);
    border-bottom-color: rgb(183, 160, 107);
    border-radius: 13px;
    padding: 12px 14px;
    margin-bottom: 10px;
    transition-property: background-color, translate;
    transition-duration: 0.15s;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 3px;
    border-left-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
}

.frow:hover {
    background-color: rgb(250, 242, 220);
    translate: 0 -1px;
}

.frow--locked {
    background-color: rgba(244, 236, 211, 0.55);
    padding: 12px 14px;
}

.frow--locked:hover {
    background-color: rgba(244, 236, 211, 0.7);
    translate: 0 0;
}

.frow__body {
    flex-grow: 1;
    margin-left: 12px;
}

.frow__name-row {
    flex-direction: row;
    align-items: center;
}

.frow__name {
    color: rgb(60, 50, 32);
    font-size: 17px;
    -unity-font-style: bold;
}

.frow__name--locked {
    color: rgb(167, 152, 104);
    font-size: 20px;
}

.frow__dot {
    width: 8px;
    height: 8px;
    rotate: 45deg;
    border-radius: 2px;
    background-color: rgb(199, 154, 60);
    margin-left: 7px;
}

.frow__meta {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.frow__hint {
    color: rgb(138, 122, 82);
    font-size: 11px;
    margin-top: 5px;
}

.frow__status {
    color: rgb(106, 90, 56);
    background-color: rgba(60, 50, 32, 0.1);
    border-radius: 5px;
    padding: 3px 8px;
    font-size: 11px;
    letter-spacing: 0.3px;
    margin-left: 7px;
}

.frow__chev {
    color: rgb(140, 118, 76);
    font-size: 32px;
    margin-left: 8px;
    background-image: none;
}

.tag {
    border-radius: 5px;
    padding: 3px 8px;
    font-size: 11px;
    letter-spacing: 0.3px;
}

.tag--person {
    background-color: rgb(60, 82, 40);
    color: rgb(231, 220, 190);
}

.tag--world {
    background-color: rgb(223, 210, 174);
    color: rgb(106, 90, 56);
    -unity-slice-scale: 0.1px;
}

.tag--artifact {
    background-color: rgb(217, 179, 106);
    color: rgb(74, 54, 24);
}

.tag--thread {
    background-color: rgb(217, 179, 106);
    color: rgb(74, 54, 24);
}

.token {
    width: 56px;
    height: 56px;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.token__frame {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background-color: rgba(60, 74, 40, 0.73);
    justify-content: center;
    align-items: center;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    rotate: 0;
}

.token__frame--green {
}

.token__frame--amber {
}

.token__frame--locked {
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 2px;
    border-color: rgb(183, 156, 110);
    border-top-width: -12px;
    border-right-width: -12px;
    border-bottom-width: -12px;
    border-left-width: -12px;
    rotate: 0;
}

.token__inner {
    justify-content: center;
    align-items: center;
}

.token__img {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    border-width: 2px;
    border-color: rgb(122, 138, 78);
    -unity-background-scale-mode: scale-and-crop;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    background-image: url("project://database/Assets/UI/Concepts/VillageHub/Sprites/npc-engineer.png?fileID=2800000&guid=c09b05f4534f3234b8324e82afaaa067&type=3#npc-engineer");
}

.token--big .token__frame {
    width: 60px;
    height: 60px;
}

.token--big .token__img {
    width: 56px;
    height: 56px;
    border-radius: 28px;
}

.glyph-circle {
    width: 48px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Flynn/Textures/solarpunk_icons.png?fileID=1588301747&guid=f7e6b187e70a3e14bb18c7a75891a324&type=3#solarpunk_icons_63");
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.89);
    -unity-background-scale-mode: scale-to-fit;
    rotate: -45deg;
}

.glyph-diamond {
    width: 26px;
    height: 26px;
    rotate: 45deg;
    border-radius: 5px;
    background-color: rgb(228, 217, 188);
}

.glyph-q {
    color: rgb(255, 255, 255);
    font-size: 31px;
    width: auto;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.glyph-lock {
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/Flynn/Textures/solarpunk_icons.png?fileID=1380540208&guid=f7e6b187e70a3e14bb18c7a75891a324&type=3#solarpunk_icons_55");
    -unity-background-scale-mode: scale-to-fit;
    rotate: -45deg;
}

.drawer__detail {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 14px;
    bottom: 12px;
    background-color: rgb(236, 224, 194);
    display: none;
}

.detail__back {
    color: rgb(94, 138, 60);
    font-size: 11px;
    letter-spacing: 1.2px;
    padding: 4px 4px 8px 4px;
}

.detail__back:hover {
    color: rgb(110, 154, 70);
}

.detail__head {
    flex-direction: row;
    align-items: center;
    padding: 0 4px 10px 4px;
}

.detail__head-text {
    margin-left: 8px;
}

.detail__name {
    color: rgb(60, 50, 32);
