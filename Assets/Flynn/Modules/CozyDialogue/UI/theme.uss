    margin-top: 2px;
}

.detail__status--green {
    color: rgb(94, 122, 46);
}

.detail__scroll {
    flex-grow: 1;
}

.dsection {
    background-color: rgb(244, 236, 211);
    border-width: 1px;
    border-color: rgb(220, 203, 158);
    border-radius: 9px;
    padding: 12px 14px;
    margin: 0 2px 10px 2px;
    border-left-color: rgb(218, 203, 160);
    border-right-color: rgb(183, 160, 107);
    border-top-color: rgb(222, 208, 169);
    border-bottom-color: rgba(183, 160, 107, 0.73);
    border-bottom-width: 3px;
    border-right-width: 1px;
}

.dsection__label {
    color: rgb(100, 86, 53);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 0;
}

.dsection__body {
    color: rgb(74, 62, 40);
    font-size: 17px;
