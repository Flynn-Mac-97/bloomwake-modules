                <ui:Label name="gauge-num" text="2" class="gauge__num" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="chip">
            <ui:Label text="Understanding" class="chip__text" />
            <ui:Label name="understand-count" text="2 / 8" class="chip__count" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
