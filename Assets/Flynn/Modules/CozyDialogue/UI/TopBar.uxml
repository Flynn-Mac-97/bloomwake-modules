<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Flynn/Modules/CozyDialogue/UI/theme.uss?fileID=7433441132597879392&amp;guid=f3549c7e273a7fe4f9f149f685d2d988&amp;type=3#theme" />
    <ui:VisualElement name="top-bar" picking-mode="Ignore" class="top-bar">
        <ui:VisualElement class="chip">
            <ui:VisualElement class="leaf-dot" />
            <ui:Label name="location-label" text="Mosslight Clearing" class="chip__text" />
        </ui:VisualElement>
